{
  "name": "@nooksure/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "NookSure AI home safety planner as an MCP server (stdio and Streamable HTTP).",
  "type": "module",
  "exports": {
    "./http": "./src/http.ts"
  },
  "bin": {
    "nooksure-mcp": "./dist/index.js"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --log-level=warning",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start:http": "tsx src/index.ts --http"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.32.1",
    "@nooksure/shared": "*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "~0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  }
}
