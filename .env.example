# Copy to .env and fill in locally. Never commit .env.
# Placeholder values only — no real credentials belong in this file.

# --- Backend ---
PORT=3001
CORS_ORIGIN=http://localhost:5173

# AI provider (server-side only). Leave AI_PROVIDER_API_KEY empty to run in
# clearly labeled FIXTURE mode — no real AI analysis is performed.
AI_PROVIDER=anthropic
AI_PROVIDER_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Supabase (server-side). The service role key is a secret: backend only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Frontend (exposed to the browser — publishable values only) ---
VITE_API_BASE_URL=http://localhost:3001
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=
