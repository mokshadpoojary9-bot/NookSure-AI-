# Copy to .env and fill in locally. Never commit .env.
# Placeholder values only — no real credentials belong in this file.

# --- Backend (server-only) ---
PORT=3001
# Development CORS origin (localhost is always allowed in development).
CORS_ORIGIN=http://localhost:5173
# Production only (Render): comma-separated frontend URLs allowed by CORS,
# e.g. https://YOUR_VERCEL_URL. Leave empty locally.
FRONTEND_ORIGIN=
# NODE_ENV is set to "production" by render.yaml on Render. Don't set it locally.

# Gemini (SECRET — server-only; never put it in a VITE_ variable). Leave empty
# to run the assistant in clearly labeled FIXTURE mode (sample replies only).
GEMINI_API_KEY=
# Optional. Defaults to the SDK-documented alias "gemini-flash-latest".
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=20000
CHAT_RATE_LIMIT_PER_MINUTE=20

# --- Frontend (bundled into the browser — publishable values only) ---
# Backend URL. Empty → http://localhost:3001. On Vercel: https://YOUR_RENDER_URL
VITE_API_BASE_URL=http://localhost:3001

# Firebase web app config for project "nooksure-ai"
# (Firebase Console → Project settings → Your apps → Web app → SDK config).
# Leave empty to run in guest mode with Google sign-in disabled.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional (Analytics is not used yet).
VITE_FIREBASE_MEASUREMENT_ID=
