rules_version = '2';

// NookSure AI — Firestore security rules.
// Paste into Firebase Console → Firestore Database → Rules, then Publish.
// Only users/{uid}/plans/{planId} is accessible, and only by that signed-in user.
// Everything else is denied (no rule matches → denied).
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Shape check for creates and updates. hasOnly() also blocks extra fields
    // such as a client-written "uid": identity comes from the path, not the data.
    function isValidPlan() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'profile', 'done', 'items', 'appVersion', 'createdAt', 'updatedAt'])
        && d.title is string
        && d.title.size() > 0
        && d.title.size() <= 120
        && d.profile is map
        && d.done is list && d.done.size() <= 500
        && d.items is list && d.items.size() <= 500
        && (!('appVersion' in d) || (d.appVersion is string && d.appVersion.size() <= 20))
        && d.updatedAt == request.time;
    }

    match /users/{uid}/plans/{planId} {
      allow read: if isOwner(uid);
      allow delete: if isOwner(uid);
      allow create: if isOwner(uid) && isValidPlan() && request.resource.data.createdAt == request.time;
      // createdAt can't be changed after creation.
      allow update: if isOwner(uid) && isValidPlan() && request.resource.data.createdAt == resource.data.createdAt;
    }
  }
}
